<Project Sdk="Microsoft.NET.Sdk">
    <!--
      ═══════════════════════════════════════════════════════════════════════
       **NOS(Nova)完整 UI 的独立程序集** —— 2026-10-11
      ═══════════════════════════════════════════════════════════════════════
      用户："就算这么做以后我们也是需要抽离到主程序集的，你想好。你现在做出来
             一模一样的效果，然后告诉我，我测完再开始抽离"

      【为什么单独一个项目】（这是今天一整天反复爆炸的**根治** ✓✓）
        Nova 的 `Nebula.cs` 里有**全局 using** ✗：
            global using Color = UnityEngine.Color;
            global using GUIWidget = Virial.Media.GUIWidget;
            global using Language = …（一堆 ✓）
        它们和我们主程序集的 `global using Color = LightInDark.Color;`
        **同名冲突** ✗ → 实测导致 12 → 110 → 1760 → 2044 个编译错的连环爆炸 ✓

        → 放进**独立程序集**后，它的 global using **只影响它自己** ✓✓
          主程序集一个都不受影响 ✓，我们照样在 `Light.dll` 里写自己的 `Color` ✓

      【抽离路径（以后合并时照这个做 ✓）】
        ① 把这 753 个文件从 `Light\UI\NovaFull\` 移进主工程目录 ✓
        ② 删掉本 csproj + 主 csproj 里的 `<ProjectReference>` 与 `<Compile Remove … NovaFull …>` ✓
        ③ **同时**把 Nova 的 `global using Color = UnityEngine.Color;` 等**删掉**
           （或把主工程的 `global using Color = LightInDark.Color;` 改名为 `LColor` ✓，
             全库替换 `Color` → `LColor` 一次即可 ✓）
        ④ 再把 `Language` 等其它同名件按同样办法处理 ✓
        ⚠️ 不做第 ③ 步就直接合并 = 今天那种连环爆炸 ✗（这条已记在心里 ✓）

      【现状】只在 Windows 上构建；产物 `Output\Light.Nova.dll` ✓
             （与主插件同目录 ✓ → 一起拷进 plugins ✓）
    -->
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DebugType>embedded</DebugType>
        <AssemblyName>Light.Nova</AssemblyName>
        <RootNamespace>Nova</RootNamespace>
        <VersionPrefix>1.0.0</VersionPrefix>
        <Description>Light In The Dark - NOS UI (ported, isolated assembly)</Description>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Nova 源码自带一份 AssemblyInfo ✗ → 让 SDK 别再生成，否则 CS0579 重复 ✓ -->
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <!-- ★★ 必须照抄 Nova 的编译符号 ✓：代码里有 74 个 `#if PC` / 28 个 `#if ANDROID` 块 ✗，不定义就会少一大堆成员（HttpClient / LobbySlideManager 全是这么"消失"的 ✓✓） -->
        <DefineConstants>$(DefineConstants);STEAM;PC</DefineConstants>

        <!-- 不生成启动对象（它是库，不是插件本体 ✓）；AssemblyInfo 让 SDK 自动生成即可 ✓ -->
        <!-- 产物统一放 Output\ ✓（与主插件同一个目录 ✓ 方便一起部署 ✓） -->
        <OutputPath>..\Output\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <ItemGroup>
        <!-- ★★ 2026-10-11：**把 Nova 的贴图作为嵌入资源** ✓✓
             —— 这是"没看到什么生效的东西"的根因 ✗：
                Nova 的 UI 全靠 `SpriteLoader.FromResource("Nebula.Resources.Xxx.png")` ✓
                贴图是**嵌入资源** ✗，我第一版把它们排除了 ✗ → 拿到 null →
                `GraphicsHelper.ToSprite` NRE ✓（用户日志实证 ✓）
             —— 名字必须是 `Nebula.Resources.<子目录用点分隔><文件名>` ✓
                （Nova 靠 RootNamespace=Nebula 自动算 ✓，我们显式写 LogicalName ✓）
             —— 排除照抄 Nova：`Resources\Libs\*` 与 `Resources\Assets\Android\*` ✗ -->
        <EmbeddedResource Include="Resources\**\*.*"
                          Exclude="Resources\Libs\**\*.*;Resources\Assets\Android\**\*.*">
            <LogicalName>Nebula.Resources.$([System.String]::Copy('%(RecursiveDir)').Replace('\','.'))%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>

        <!-- ★ NOS(Nova)的全量源码（753 个 .cs / 13.3 万行 ✓） -->
        <Compile Include="..\Light\UI\NovaFull\**\*.cs" />

        <!-- ⚠️ 语音聊天**不参与编译** ✗ —— 它依赖另一个模组 `Interstellar.dll`
             （NOS 的 csproj 里写 `<Reference Include="$(AmongUsRelease)\Interstellar.dll" />` ✓）
             我们没搬那个 DLL，也**不需要**它 ✓（目标是"设置界面一模一样" ✓，语音无关 ✓）
             → 实测它一家就贡献了 130+ 个错 ✓ -->        <Compile Remove="..\Light\UI\NovaFull\NebulaPluginNova\VoiceChat\**\*.cs" />        <!-- ⚠️ 与"设置界面"无关、且依赖 Nova 深层内部/外部模组的文件 ✗（精准排除 ✓，不动 UI 相关的 ✓） -->

        <Compile Remove="..\Light\UI\NovaFull\NebulaPluginNova\Roles\Crewmate\Ubiquitous.cs" />



        <!-- 不嵌入那 481 张图（9.4MB ✗）—— 需要哪张再单独拷进主工程的 Resources ✓ -->
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LightAPI\LightInDark.csproj" />
    </ItemGroup>

    <!-- 照主工程的引用方式 ✓（Libs\*.dll = 游戏的 interop + BepInEx ✓） -->
    <Target Name="AddGameReferences" BeforeTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <_LibDlls Include="..\Libs\*.dll" Exclude="..\Libs\netstandard.dll" />
            <Reference Include="@(_LibDlls->'%(FileName)')">
                <HintPath>%(FullPath)</HintPath>
                <Private>false</Private>
            </Reference>
        </ItemGroup>
    </Target>
</Project>
